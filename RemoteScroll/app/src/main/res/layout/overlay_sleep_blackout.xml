<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blackoutRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clickable="true"
    android:focusable="true">

    <!-- FLOATING GESTURE NOTIFICATION BADGE (Top Center) -->
    <TextView
        android:id="@+id/textGestureBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="80dp"
        android:alpha="0"
        android:background="@drawable/bg_mini_bubble"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp"
        android:text="▼ Next Video"
        android:textColor="#00D2FF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- ULTRA-DIM OLED HUD (Center) -->
    <LinearLayout
        android:id="@+id/hudContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TIME -->
        <TextView
            android:id="@+id/textClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="00:00"
            android:textColor="#64748B"
            android:textSize="44sp"
            android:textStyle="bold" />

        <!-- BATTERY & STATUS -->
        <TextView
            android:id="@+id/textBatteryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:letterSpacing="0.02"
            android:text="🔋 --%  •  🌙 Sleep Blackout"
            android:textColor="#475569"
            android:textSize="13sp" />

        <!-- HUD ACTION BUTTONS -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnHudPausePlay"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_mini_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="⏯️ Pause / Play"
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnHudWake"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_mini_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="✕ Wake Screen"
                android:textColor="#00D2FF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SUBTLE INSTRUCTIONS -->
        <TextView
            android:id="@+id/textHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="Swipe Up/Down for Next/Prev  •  Double-tap to wake"
            android:textColor="#334155"
            android:textSize="11sp" />
    </LinearLayout>

</FrameLayout>
