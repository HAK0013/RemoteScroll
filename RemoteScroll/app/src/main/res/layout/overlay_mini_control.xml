<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ==================== COLLAPSED BUBBLE ==================== -->
    <LinearLayout
        android:id="@+id/layoutCollapsed"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mini_bubble"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/textBubbleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:text="⚡ RS"
            android:textColor="@color/brand"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ==================== EXPANDED CONTROL PANEL ==================== -->
    <LinearLayout
        android:id="@+id/layoutExpanded"
        android:layout_width="282dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_mini_panel"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <!-- HEADER / DRAG HANDLE -->
        <LinearLayout
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="0.04"
                android:text="⚡ QUICK CONTROL"
                android:textColor="@color/brand"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnMinimize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="➖"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:text="✕"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PRIMARY ROW: AUTO-LOCK, 2X TURBO, SLEEP & POCKET LOCK -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAutoLock"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mini_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🎯 Auto: Off"
                android:textColor="@color/console_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnTurbo2x"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_mini_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="⏩ 2x"
                android:textColor="@color/brand"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSleep"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_mini_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="🌙 Sleep"
                android:textColor="#C084FC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPocketLock"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="5dp"
                android:background="@drawable/bg_mini_btn_accent"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="🔒 Lock"
                android:textColor="#0B0F19"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- SECONDARY ROW: SCROLL SHORTCUTS & APP SETUP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPrev"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mini_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▲ Prev"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mini_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="▼ Next"
                android:textColor="@color/text_primary"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnPoints"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_mini_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🎯 Points"
                android:textColor="@color/console_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1.1"
                android:background="@drawable/bg_mini_btn"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⚙️ Setup"
                android:textColor="@color/brand"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
