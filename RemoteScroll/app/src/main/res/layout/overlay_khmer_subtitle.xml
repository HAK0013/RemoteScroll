<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/subtitleRootCard"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_subtitle_panel"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Top compact status & quick actions bar -->
    <LinearLayout
        android:id="@+id/subtitleDragBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textSubStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="🇰🇭 YT → ខ្មែរ • Listening..."
            android:textColor="@color/brand"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubVoice"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_mini_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="🔇 TTS"
            android:textColor="@color/console_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubTone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_mini_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="🎭"
            android:textColor="#C084FC"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubVol"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_mini_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="🔉 85%"
            android:textColor="#38BDF8"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubSpeed"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_mini_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="5dp"
            android:paddingEnd="5dp"
            android:text="1.3x"
            android:textColor="#FBBF24"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubOrig"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_mini_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="Aa"
            android:textColor="@color/brand"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubRestart"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_mini_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:text="🔄"
            android:textColor="#34D399"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubClose"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_mini_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="⏹"
            android:textColor="#F87171"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Original spoken phrase (optional) -->
    <TextView
        android:id="@+id/textSubOriginal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- Real-time Khmer translation -->
    <TextView
        android:id="@+id/textSubKhmer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:text="កំពុងស្តាប់សំឡេង YouTube..."
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />
</LinearLayout>
